# Which of an imagined step's predictions reality did not deliver. As an ordinary program.
#
# This was `workbench.unmet_expectations`, the third of the predicates the capability audit decomposed,
# and the audit's verdict was that it needed **no capability at all** — which was true and not the whole
# story. It was blocked twice over, both times by REPRESENTATION rather than by control flow:
#
#   * its input was a Python dict     -> `predicted_changes` returns a `prediction` node
#   * its output was PROSE            -> it answers with facts; `explain_unmet` renders them
#
# The second is the one worth remembering. A predicate that answers in sentences cannot move here, and
# not because the surface is weak: `repr` is a rendering decision, and a rendering decision inside a
# predicate is a second thing the predicate is for. Separating them is what made this a transcription.
#
# Everything it reads is graph data already. Bindings live on the replay (`r -bound-> b`, each naming a
# `mapping` and the real `node` standing for it), and `mints` is what `activation.gather_minted` hands
# back. Nothing new was added for this.

# The real node standing for `mapping` in this replay, or nothing.
#
# Through the replay's index (`execution.bind` writes it), never the reverse index and never a walk of
# the `bound` edges. The reverse index sorts by node id, which is the trap this codebase has twice paid
# for; and the forward walk is correct but O(world), because `open_execution` seeds a binding per node in
# frame 0. A stored reference is neither.
fn bound_node(replay, mapping) -> thing:
    DEREF R(b) F(replay) F(mapping)
    JMPNOT R(b) .missing
    GET R(result) R(b) "node"
    JMP .end
.missing:
    CONST R(result) null
.end:
    CONST R(done) true


# Did the real call mint anything of this kind? A witness, never a count: a mock that mints two file
# nodes is illustrating, not promising, so one of the right kind satisfies the expectation.
fn minted_a(mints, wanted) -> thing:
    COUNT R(n) F(mints) "found"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .no
    GET_AT R(made) F(mints) "found" R(i)
    KIND R(k) R(made)
    EQ R(same) R(k) F(wanted)
    JMPIF R(same) .yes
    ADD R(i) R(i) 1
    JMP .each
.yes:
    CONST R(result) true
    JMP .end
.no:
    CONST R(result) false
.end:
    CONST R(done) true


# Does `node` have an edge labelled `label` pointing at `other`?
fn has_edge_to(node, label, other) -> thing:
    COUNT R(n) F(node) F(label)
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .no
    GET_AT R(t) F(node) F(label) R(i)
    EQ R(same) R(t) F(other)
    JMPIF R(same) .yes
    ADD R(i) R(i) 1
    JMP .each
.yes:
    CONST R(result) true
    JMP .end
.no:
    CONST R(result) false
.end:
    CONST R(done) true


# The unmet expectations, as a node with ordered `missed` edges. Nothing on it means the step went as
# planned. Each miss names the `expectation` it came from, so a reader can ask what was expected without
# the miss having to repeat it.
#
# An expectation whose mapping stands for nothing real is SKIPPED rather than failed: the plan referred
# to something that does not exist yet in the real graph, which `execution.step` reports separately as an
# unbound argument. Two different complaints, and merging them would name the wrong cause.
fn unmet_expectations(prediction, replay, mints) -> thing:
    NEW R(out) "unmet"
    COUNT R(ne) F(prediction) "expect"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(ne)
    JMPNOT R(more) .done
    GET_AT R(e) F(prediction) "expect" R(i)
    ATTR R(sort) R(e) "sort"

    EQ R(is_kind) R(sort) "kind"
    JMPNOT R(is_kind) .resolve
    ATTR R(wanted) R(e) "wanted"
    INVOKE R(made) minted_a mints=F(mints) wanted=R(wanted)
    JMPIF R(made) .next
    NEW R(miss) "missing_kind"
    SET R(miss) "wanted" R(wanted)
    JMP .record

    # Everything below is about a node reality actually produced.
.resolve:
    GET R(m) R(e) "mapping"
    INVOKE R(node) bound_node replay=F(replay) mapping=R(m)
    JMPNOT R(node) .next

    EQ R(is_attr) R(sort) "attr"
    JMPNOT R(is_attr) .link
    ATTR R(key) R(e) "key"
    ATTR R(got) R(node) R(key)
    ATTR R(mode) R(e) "mode"
    EQ R(loose) R(mode) "set"
    JMPNOT R(loose) .exact

    # *Written, value unspecified* — so only an ABSENT attribute disappoints it. Tested against `null`
    # and never by truthiness: an attribute holding `false` is set, and jumping on the value would call
    # that a failure. The dict this replaces said `got is None` for the same reason.
    EQ R(absent) R(got) null
    JMPNOT R(absent) .next
    NEW R(miss) "unset_attr"
    SET R(miss) "key" R(key)
    JMP .record

.exact:
    ATTR R(want) R(e) "want"
    EQ R(same) R(got) R(want)
    JMPIF R(same) .next
    NEW R(miss) "wrong_attr"
    SET R(miss) "key" R(key)
    SET R(miss) "want" R(want)
    SET R(miss) "got" R(got)
    JMP .record

    # A named target can be checked exactly; an imagined one can only be expected to APPEAR, because it
    # does not exist yet and what stands for it is decided at execution time. `presence` carries that:
    # *some* edge, or *none*.
.link:
    ATTR R(label) R(e) "label"
    GET R(to) R(e) "target"
    ATTR R(presence) R(e) "presence"
    JMPNOT R(to) .by_presence
    INVOKE R(there) has_edge_to node=R(node) label=R(label) other=R(to)
    JMPIF R(there) .next
    NEW R(miss) "missing_edge"
    SET R(miss) "label" R(label)
    LINK R(miss) "to" R(to)
    JMP .record

.by_presence:
    COUNT R(have) R(node) R(label)
    EQ R(wants_some) R(presence) "some"
    JMPNOT R(wants_some) .wants_none
    JMPIF R(have) .next
    NEW R(miss) "no_edge"
    SET R(miss) "label" R(label)
    JMP .record

.wants_none:
    JMPNOT R(have) .next
    NEW R(miss) "extra_edge"
    SET R(miss) "label" R(label)
    SET R(miss) "found" R(have)

.record:
    LINK R(miss) "expectation" R(e)
    LINK R(out) "missed" R(miss)
.next:
    ADD R(i) R(i) 1
    JMP .each
.done:
    COPY R(result) R(out)
