# A generic circuit breaker: watch any rule, at a threshold of its own,
# without editing the rule being watched -- and the suspension is
# TEMPORARY, not a permanent kill. A rule whose gate is shut for ever is
# starved of its own future legitimate work; the point is to stop it
# burning the tick budget, not to silence it for good.
#
# Rewritten for the edge-triggered engine (`core/firing.py`). What that
# engine changed, and what each change cost this corpus:
#
#   NOTHING IS CONSUMED.  Reading no longer spends. `<trip>` used to shut
#                     the gate by READING it -- consumption did the
#                     shutting -- and now says `-gate($tag)` out loud.
#                     Every place this corpus relied on a read to clear
#                     something is now an explicit erase, and there is
#                     no `keep` anywhere because there is nothing to opt
#                     out of.
#
#   REFRACTION.       A rule fires once per instantiation. That is why no
#                     rule here carries a "have I done this already"
#                     guard: firing once is the engine's job now.
#
#   THE CLOCK.        `<cooldown-tick>` counts TICKS, and a rule with no
#                     changing input of its own never fires -- so it reads
#                     `clock($t)`, which is what opts a rule into time.
#                     Without it the countdown simply never gets a turn.
#
#   WHAT A RUNAWAY IS NOW.  This is the real change, and it retires most
#                     of what this file used to argue. Starvation is gone
#                     (nothing schedules, so nothing can be starved) and
#                     so is the rule that fires for ever on a fixed
#                     antecedent (refraction fires it once). The ONLY
#                     runaway left is a rule that keeps MINTING: every
#                     mint is a new node, a new instantiation, and so a
#                     fresh turn. Counting mints is therefore the whole
#                     job, and `beat($tag)` -- minted by the watched rule
#                     once per firing -- is exactly a mint counter.
#
# To watch a rule: give it `gate(a-tag)` in its antecedent and
# `+beat(a-tag)` in its consequent, then
# `fact +gate(a-tag)`, `fact +tries(a-tag, 0)`,
# `fact +threshold(a-tag, N)`, `fact +cooldown_len(a-tag, ROUNDS)`.

# Counts the watched rule's own beats. Each `+beat($tag)` the watched rule
# mints is a distinct node, so each is a distinct instantiation here and
# gets counted exactly once. The beat is erased as it is counted: nothing
# else reads it, and leaving spent beats standing would grow the match
# space for no reader.
rule <watchdog> = implies(
    { +beat($tag), +tries($tag, $n), plus($n, 1) as $n2 },
    { -beat($tag), -tries($tag, $n), +tries($tag, $n2) } )

# Over threshold: shut the gate. `-gate($tag)` is the suspension, and it
# is said explicitly because reading no longer spends. `no cooling($tag)`
# keeps this from tripping again while a cooldown is already running.
rule <trip> = implies(
    { +tries($tag, $n), +threshold($tag, $max), at_least($n, $max) as $over,
      +cooldown_len($tag, $len), +gate($tag), no cooling($tag) },
    { +cooling($tag), +cooldown($tag, $len), -gate($tag) } )

# The countdown, and the one rule here that is driven by TIME rather than
# by something the machine did. It cannot be measured by the watched
# rule's own activity -- with its gate shut it beats nothing to count --
# so `clock($t)` is what gives it a turn, once per tick, whatever else is
# or is not happening.
rule <cooldown-tick> = implies(
    { clock($t), +cooling($tag), +cooldown($tag, $c),
      at_least($c, 1) as $more, minus($c, 1) as $c2 },
    { -cooldown($tag, $c), +cooldown($tag, $c2) } )

# Once the cooldown reaches 0: reopen the gate, and reset the count so the
# rule gets a full fresh budget rather than tripping again on its first
# move. Every fact this consumed in the old sense is now erased by name.
rule <revive> = implies(
    { +cooling($tag), +cooldown($tag, 0), +tries($tag, $n) },
    { +gate($tag), -cooling($tag), -cooldown($tag, 0),
      -tries($tag, $n), +tries($tag, 0) } )
