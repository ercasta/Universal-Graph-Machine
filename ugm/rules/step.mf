# Taking a step on a workbench, as ordinary programs.
#
# This was `workbench.step`, the largest single piece of Python left below the plan-act-check loop. It is
# not a primitive and never was: it is a frame copy, a choice among declared outcomes, one call, and a
# record of what was done. What blocked writing it here was never its control flow — it was four things
# the surface could not say, closed one at a time and each recorded where it lives:
#
#   * copying a set of nodes WITH their edge properties   -> `copy_set`, and NEPROPS/EPROP_AT/SETEPROP
#   * building a binding set at run time                  -> `INVOKE ... with <node>`
#   * asking what a call just did                         -> `SELF`, then the newest `caller` source
#   * declining a request                                 -> `REFUSE`
#
# Two natives remain, and both are boundaries rather than shortcuts. `find_function` resolves a name to
# its node: decomposing it reaches `g.of_kind`, and handing the surface a way to enumerate every node of
# a kind is the whole-graph scan `types.instances` refuses at length. `minted` gathers what a call
# created: decomposing it reaches a set union and a sort, and that sort decides which imagined node
# `execution._bind_minted` pairs with which real one, so it is not something to approximate.


# Which node `args` binds to `param`, or nothing. A parameter absent from the binding set answers
# nothing, which is different from answering a node — see `outcome_fits`, where the difference decides
# whether a condition is tested at all.
fn binding_value(args, param) -> thing:
    COUNT R(n) F(args) "arg"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .missing
    GET_AT R(b) F(args) "arg" R(i)
    ATTR R(p) R(b) "param"
    EQ R(same) R(p) F(param)
    JMPIF R(same) .found
    ADD R(i) R(i) 1
    JMP .each
.found:
    GET R(result) R(b) "value"
    JMP .end
.missing:
    CONST R(result) null
.end:
    CONST R(done) true


# Do this outcome's conditions hold of these arguments? A mock's condition IS its parameter types, so
# there is no second representation to keep in step — this asks `is_a` what `invoke` would enforce
# anyway, only before choosing rather than after.
#
# A parameter with no declared type is unconstrained and passes. A parameter absent from `args` is NOT
# tested: partial bindings are the planner's business, and treating an unbound parameter as a failed
# condition would silently rule out every outcome.
fn outcome_fits(outcome, args) -> thing:
    COUNT R(np) F(outcome) "param"
    CONST R(i) 0
.each_param:
    LT R(more) R(i) R(np)
    JMPNOT R(more) .fits
    GET_AT R(p) F(outcome) "param" R(i)
    ATTR R(want) R(p) "type"
    JMPNOT R(want) .next_param
    ATTR R(pname) R(p) "name"
    INVOKE R(bound) binding_value args=F(args) param=R(pname)
    JMPNOT R(bound) .next_param
    NATIVE R(ok) "is_a" R(bound) R(want)
    JMPNOT R(ok) .no
.next_param:
    ADD R(i) R(i) 1
    JMP .each_param
.no:
    CONST R(result) false
    JMP .end
.fits:
    CONST R(result) true
.end:
    CONST R(done) true


# The declared outcome to assume, given the state these arguments describe — as a function node, or
# nothing when the function declares no outcomes at all.
#
# Conditioned on the world rather than on declaration order, which is the point: *"what will happen if I
# do this here"* used to be answered by something that could not see "here". Declaration order still
# decides among several that fit, which is what `mock`'s ordering was always for.
#
# Falling back to the first outcome when NOTHING fits is deliberate. The honest report is then the
# `TypeViolation` naming the condition that failed, which says *no declared outcome covers this state*;
# quietly substituting the real function instead would reach for the world from inside a workbench.
fn choose_outcome(fnode, args) -> thing:
    COUNT R(nm) F(fnode) "mock"
    JMPNOT R(nm) .none
    CONST R(i) 0
.each_mock:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .fallback
    GET_AT R(mk) F(fnode) "mock" R(i)
    INVOKE R(fits) outcome_fits outcome=R(mk) args=F(args)
    JMPIF R(fits) .picked
    ADD R(i) R(i) 1
    JMP .each_mock
.fallback:
    GET_AT R(result) F(fnode) "mock" 0
    JMP .end
.picked:
    COPY R(result) R(mk)
    JMP .end
.none:
    CONST R(result) null
.end:
    CONST R(done) true


# The outcome of `fnode` called `name`, or nothing. What `assume` is checked against — naming an
# outcome that was never declared is a claim about the REQUEST, so `step` refuses it rather than
# quietly running something else.
fn outcome_named(fnode, name) -> thing:
    COUNT R(nm) F(fnode) "mock"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .missing
    GET_AT R(mk) F(fnode) "mock" R(i)
    ATTR R(mkname) R(mk) "name"
    EQ R(same) R(mkname) F(name)
    JMPIF R(same) .found
    ADD R(i) R(i) 1
    JMP .each
.found:
    COPY R(result) R(mk)
    JMP .end
.missing:
    CONST R(result) null
.end:
    CONST R(done) true


# A new frame derived from `frame`: every image copied, one carried mapping per old mapping.
#
# The previous frame is left intact, because the new frame is a full copy taken BEFORE anything runs.
# That is what makes the movie real — every earlier state stays inspectable rather than being
# reconstructible only by replay.
#
# Returns a scratch node the caller drops, carrying three things it needs: a `frame` edge to the new
# frame, and refs keyed by node id for both maps — old image to new image (left by `copy_set`) and old
# mapping to new mapping. One node rather than three, because they have one lifetime.
#
# ORDERED dedupe of the images, never a set. `mapping` is an ordered edge, so this frame's order is a
# fact about it; a set would replace that with node-id hash order and make every later frame's mapping
# order — and so `driver.proposals`' order, and so the search — arbitrary. That is the same defect
# `reachable` records at length, and the seen-marking here is its idiom: a ref on the scratch node,
# keyed by node id, never a mark on the world. `copy_set` then overwrites each of those refs with the
# image, which is safe only because collecting finishes before copying starts.
fn carry_frame(wb, frame) -> thing:
    NEW R(sc) "carry"
    COUNT R(nm) F(frame) "mapping"
    CONST R(i) 0
.collect:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .copy
    GET_AT R(m) F(frame) "mapping" R(i)
    GET R(img) R(m) "image"
    DEREF R(seen) R(sc) R(img)
    JMPIF R(seen) .skip
    SETREF R(sc) R(img) R(img)
    LINK R(sc) "found" R(img)
.skip:
    ADD R(i) R(i) 1
    JMP .collect

.copy:
    INVOKE R(copied) copy_set walk=R(sc)
    NEW R(nf) "frame"
    ATTR R(idx) F(frame) "index"
    EQ R(no_idx) R(idx) null
    JMPNOT R(no_idx) .have_index
    CONST R(idx) 0
.have_index:
    ADD R(next_index) R(idx) 1
    SET R(nf) "index" R(next_index)
    LINK F(wb) "frame" R(nf)
    LINK R(sc) "frame" R(nf)

    CONST R(i) 0
.carry:
    LT R(more_c) R(i) R(nm)
    JMPNOT R(more_c) .done
    GET_AT R(m) F(frame) "mapping" R(i)
    GET R(img) R(m) "image"
    DEREF R(new_img) R(sc) R(img)
    NEW R(nmap) "mapping"
    GET R(orig) R(m) "original"
    JMPNOT R(orig) .no_original
    LINK R(nmap) "original" R(orig)
.no_original:
    LINK R(nmap) "image" R(new_img)
    LINK R(m) "next" R(nmap)
    LINK R(nf) "mapping" R(nmap)
    SETREF R(sc) R(m) R(nmap)
    ADD R(i) R(i) 1
    JMP .carry
.done:
    COPY R(result) R(sc)


# Run `function` on a new frame derived from `frame`, and record the transformation. Returns the new
# frame; the transformation is its `via`, so one return value carries both and nothing has to agree
# about the order of a pair.
#
# `bindings` is a node with `arg` edges — `param` naming the parameter and `value` pointing at a mapping
# in `frame`, never at a raw node, so the record stays replayable. `assume` names which declared outcome
# to take; `assumes` supplies a hypothesis rather than minting one. Both may be nothing.
#
# On a workbench a function that declares outcomes is replaced by one of them, ALWAYS. This is a
# convenience and not the safety mechanism: safety is `dispatch.service` refusing an imagined target, so
# a dispatching function could not reach the world from here even if this substitution were bypassed.
# Conflating the two would put the guarantee in the wrong place.
#
# Choosing an outcome IS making an assumption, so it becomes a hypothesis the transformation records —
# which is what lets a plan carry its own dependence on guesses, as a lookup rather than a judgement
# somebody has to remember to make.
fn step(wb, frame, function, bindings, assume, assumes) -> thing:
    INVOKE R(sc) carry_frame wb=F(wb) frame=F(frame)
    GET R(nf) R(sc) "frame"

    # The same parameters, rebound to this frame's images — the arguments the call actually gets.
    NEW R(args) "bindings"
    COUNT R(nb) F(bindings) "arg"
    CONST R(i) 0
.each_arg:
    LT R(more) R(i) R(nb)
    JMPNOT R(more) .pick
    GET_AT R(b) F(bindings) "arg" R(i)
    ATTR R(p) R(b) "param"
    GET R(m) R(b) "value"
    DEREF R(carried) R(sc) R(m)
    GET R(img) R(carried) "image"
    NEW R(nb2) "binding"
    SET R(nb2) "param" R(p)
    LINK R(nb2) "value" R(img)
    LINK R(args) "arg" R(nb2)
    ADD R(i) R(i) 1
    JMP .each_arg

.pick:
    NATIVE R(f) "find_function" F(function)
    JMPIF F(assume) .named
    INVOKE R(chosen) choose_outcome fnode=R(f) args=R(args)
    JMP .chosen
.named:
    INVOKE R(chosen) outcome_named fnode=R(f) name=F(assume)
    JMPIF R(chosen) .chosen
    ADD R(why) F(assume) " is not a declared outcome of "
    ADD R(why) R(why) F(function)
    REFUSE "UndeclaredOutcome" R(why)
.chosen:
    COPY R(executed) R(f)
    JMPNOT R(chosen) .run
    COPY R(executed) R(chosen)
.run:
    ATTR R(executed_name) R(executed) "name"
    INVOKE R(out) R(executed_name) with R(args)

    # What that call did — the last of the calls this activation has made.
    #
    # `called`, never the reverse of `caller`. `g.sources` sorts by node id, so "the newest source" is
    # really "the lexicographically largest", and once ids reach four digits that is not the same thing.
    # This read the frame and mappings that `carry_frame` had minted as though `list_dir` had minted
    # them, and it was the benchmark rather than any check that caught it.
    SELF R(me)
    COUNT R(nc) R(me) "called"
    ADD R(last) R(nc) -1
    GET_AT R(ran) R(me) "called" R(last)

    # A function may mint while imagining. Those nodes get mappings with NO `original`, which is
    # meaningful rather than broken: it says this does not exist yet and must be created when the plan
    # runs for real. What ties one to reality later is the transformation that produced it.
    NATIVE R(mints) "minted" R(ran)
    COUNT R(n_minted) R(mints) "found"
    CONST R(i) 0
.each_mint:
    LT R(more_m) R(i) R(n_minted)
    JMPNOT R(more_m) .hypothesis
    GET_AT R(made) R(mints) "found" R(i)
    NEW R(mm) "mapping"
    LINK R(mm) "image" R(made)
    LINK R(nf) "mapping" R(mm)
    ADD R(i) R(i) 1
    JMP .each_mint

.hypothesis:
    COPY R(assumption) F(assumes)
    JMPIF R(assumption) .record
    JMPNOT R(chosen) .record
    ATTR R(turns_out) R(chosen) "returns"
    JMPIF R(turns_out) .have_label
    ATTR R(turns_out) R(chosen) "name"
.have_label:
    ADD R(label) F(function) " turns out "
    ADD R(label) R(label) R(turns_out)
    NEW R(assumption) "hypothesis"
    SET R(assumption) "label" R(label)
    SET R(assumption) "status" "open"

.record:
    NEW R(tr) "transformation"
    SET R(tr) "function" F(function)
    SET R(tr) "executed" R(executed_name)
    ATTR R(expects) R(executed) "returns"
    SET R(tr) "expects" R(expects)
    LINK R(tr) "applies" R(f)
    JMPNOT R(ran) .no_activation
    LINK R(tr) "ran" R(ran)
.no_activation:
    CONST R(i) 0
.each_binding:
    LT R(more_b) R(i) R(nb)
    JMPNOT R(more_b) .finish
    GET_AT R(b) F(bindings) "arg" R(i)
    ATTR R(p) R(b) "param"
    GET R(m) R(b) "value"
    DEREF R(carried) R(sc) R(m)
    NEW R(bind) "binding"
    SET R(bind) "param" R(p)
    LINK R(bind) "mapping" R(carried)
    LINK R(tr) "arg" R(bind)
    ADD R(i) R(i) 1
    JMP .each_binding

.finish:
    JMPNOT R(assumption) .no_assumption
    LINK R(tr) "assumes" R(assumption)
.no_assumption:
    LINK F(frame) "next" R(nf)
    LINK R(nf) "via" R(tr)

    # The scratch nodes and the argument set are this call's own bookkeeping, so they go rather than
    # being left for `forget` to reason about. The argument bindings are dropped one at a time, because
    # dropping the set they hang off would orphan them.
    #
    # ALWAYS THE FIRST ONE, never an index that walks forward. Dropping a node removes the edges pointing
    # at it, so `arg` shrinks underneath a counting loop and every second binding would survive — an edge
    # list consumed by something that deletes edges, which is the shape `forget` records finding the hard
    # way. Re-reading the count each time is the whole fix.
.free:
    COUNT R(left) R(args) "arg"
    JMPNOT R(left) .freed
    GET_AT R(spent) R(args) "arg" 0
    DROP R(spent)
    JMP .free
.freed:
    DROP R(args)
    DROP R(mints)
    DROP R(sc)
    COPY R(result) R(nf)
