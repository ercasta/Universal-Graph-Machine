# Intake: deciding what a mention denotes, as rules.
#
# Identity in this engine has always been settled by construction -- the loader's
# name table decides it when a name is READ, and interning decides it for
# compounds. That is right for authored knowledge, where a corpus is a bound and
# `kettle` means one node inside it. It is wrong for anything that arrives:
# *a man walked in; a man sat down* is two mentions that may or may not be one
# man, and intake cannot know which.
#
# So nothing below assumes. A MENTION is its own node, an ENTITY is what a
# mention denotes, and `denotes` is an ordinary claim a rule concludes and
# another rule can deny.
#
#     mention      an event of speaking. Two mentions are never one mention.
#     entity       what is being spoken about. Labelless -- see `ugm/intake.py`.
#     denotes      the reading, and it is defeasible
#
# ⚠ **A name is a mention like any other.** `paul` is privileged today: it is
# stamped on the node and it decides identity at intake, while every other way
# of picking the same thing out -- *the man who walked in* -- is a claim. Here
# both are mentions, and the check that this is real is that replacing every
# entity with a labelless node changes no conclusion.

# -- the world the agent can already see -------------------------------------

fact +is(gob_a, goblin)
fact +is(gob_b, goblin)
fact +is(elf_e, elf)

fact +turn(7)
fact +back(7, 3, 4)
fact +back(7, 1, 6)

fact +attacked(gob_a, hero, 4)
fact +attacked(gob_b, hero, 6)

# An indexical is an ordinary fact, so a different addressee is a different
# fact rather than a different interpreter.
fact +refers(you, hero)

# -- what arrived, as mentions -----------------------------------------------
#
# Each is its own node. Nothing here says m1 and m3 are about the same goblin,
# and nothing may assume it.

fact +mention(m1, turns(3, ago, attack(goblin, you)))
fact +mention(m2, turns(1, ago, attack(goblin, you)))
fact +mention(m3, attack(goblin, you))

# ⭐⭐⭐ **A PROPER NAME, and it is a mention like any other.** This is the whole
# argument about privileged denotation, made checkable: `grish` picks out the
# same goblin that *the goblin you attacked 3 turns ago* picks out, and it does
# it through the SAME relation, read by a rule of the same shape. Nothing about
# a name is built into the substrate here -- it is a claim, `named(gob_a,
# grish)`, that a rule could deny.
fact +named(gob_a, grish)
fact +mention(m4, name(grish))

# -- reading ------------------------------------------------------------------

# Locate a described event in time. `via` records that the outer description is
# read THROUGH the inner one, which is what lets the denotation compose.
rule <at> = implies(
    { +mention($m, turns($n, ago, $ev)), +turn($now), +back($now, $n, $then) },
    { +ev_at($m, $ev, $then), +via($m, $ev) } )

# ...and the subject of that event is what the description denotes.
rule <ev> = implies(
    { +ev_at($m, attack($kind, $whom), $t), +refers($whom, $target),
      +attacked($g, $target, $t), +is($g, $kind) },
    { +denotes($m, $g) } )

# A name denotes what it names. One rule, no notation, no privileged route.
rule <name> = implies(
    { +mention($m, name($w)), +named($g, $w) },
    { +denotes($m, $g) } )

# A description with no time in it is satisfied by every matching event, which
# is what makes m3 ambiguous rather than wrong.
rule <bare> = implies(
    { +mention($m, attack($kind, $whom)), +refers($whom, $target),
      +attacked($g, $target, $t), +is($g, $kind) },
    { +denotes($m, $g) } )

# -- the definite article, as a count -----------------------------------------
#
# ⭐⭐⭐ *The* goblin is not a word the engine knows. It is **exactly one thing
# satisfies this description**, which is a claim about the SET of readings -- and
# a rule sees one binding at a time, so only the machinery can answer it.
#
# ⚠ **Asked at `quiet`, and that is not a detail.** A count is true of a moment
# and the next entry can falsify it, so counting a reading still being derived
# answers about a half-finished search. `quiet` is the engine's own record that
# nothing further applies -- the same occasion `unsupported` waits for.
#
# ⚠⚠⚠ **And `quiet` means NOTHING MORE APPLIES TO THE MIND I CURRENTLY HAVE,
# which is weaker than *the search is complete*.** Take a rule out of mind and
# the count changes under you. Measured on THIS corpus, `<bare>` dormant:
#
#     everything in mind    counted(count(denotes(m3, $g)), 2)   unclear(m3)
#     <bare> dormant        counted(count(denotes(m3, $g)), 0)   fits_nothing(m3)
#
# Here the narrowing is benign: with nothing left to read m3 with, the corpus
# says so. ⚠ It is NOT benign when another rule still supplies ONE reading --
# measured on a variant carrying a second denoting rule, `<bare>` dormant gives
# `counted(..., 1)` and the agent RESOLVES m3 instead of reporting the
# ambiguity. Not less certain: **confidently wrong**. Which of the two happens
# depends on the corpus, not on the engine.
#
# ⭐ **That is not a defect, and the engine must not annotate it.** An aggregate
# is always relative to what was looked at: `counted(..., 1)` means *one, among
# what I decided to consider*, exactly as `all` means *all of what I checked*.
# There is no view from nowhere to compare it against, and a machinery that
# flagged the narrowing would be second-guessing a judgement the agent made --
# which is the one thing `docs/deposit-dont-decide.md` says it may not do.
#
# ⭐⭐ **And the record already exists**, so nothing needs adding: `dormant(<r>)`
# is an ordinary claim, dated and attributable and deniable, so *what was in
# mind when this was counted* is an ordinary query. This comment previously
# said an aggregate over an unfinished search "is a lie", which overclaimed:
# it is legitimate over the search THE AGENT CHOSE TO RUN, and choosing is the
# agent's business.
rule <ask> = implies(
    { +quiet($s), +mention($m, $d) },
    { +count(denotes($m, $g)) } )

# One reading: the description picks out a thing, and the agent may act on it.
rule <the> = implies(
    { +counted(count(denotes($m, $any)), 1), +denotes($m, $g) },
    { +resolved($m, $g) } )

# Two: say so. **Nothing picks one.** Which reading to take is a decision, and
# the engine deposits the number rather than making it.
rule <ambiguous> = implies(
    { +counted(count(denotes($m, $any)), 2) },
    { +unclear($m) } )

# None: the description fits nothing the agent knows about.
#
# ⚠ NOT called `unmet`: that is a name the engine reserves for backward
# reading, and a corpus relation sharing it would be the same node -- two
# meanings on one name, which this repository has paid for repeatedly.
rule <empty> = implies(
    { +counted(count(denotes($m, $any)), 0) },
    { +fits_nothing($m) } )

# -- coreference, WITHOUT merging anything ------------------------------------
#
# ⭐⭐⭐ Two mentions corefer when they denote one entity. That needs no identity
# merge, no repointing and nothing irreversible: the mentions stay two mentions,
# which is right, because they are two events of speaking with their own times
# and their own speakers. Retracting the reading is denying one fact.
# ⚠ It concludes `corefer(m, m)` as well, because the surface has no inequality
# and *two different mentions* is not a premise this corpus can state. Reported
# rather than filtered: the reflexive pairs are noise an author has to know
# about, and hiding them in the runner would be the instrument lying.
rule <corefer> = implies(
    { +resolved($m1, $g), +resolved($m2, $g) },
    { +corefer($m1, $m2) } )
