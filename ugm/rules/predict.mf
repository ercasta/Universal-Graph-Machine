# What an imagined step said would happen — derived from two frames, as an ordinary program.
#
# This was `workbench.predicted_changes`, and it was not on the handoff's list of what stood between
# `execution.step` and the surface. That omission is itself the lesson the project already records: **a
# recorded gap statement is a hypothesis, not an inventory.** `deviates` and `unmet_expectations` were
# named as the blockers because they are predicates; this one is a *producer*, it already answered with a
# node, and answering with a node is what made it look done. It was not: a node a rule cannot ask for is
# still Python, and `execution.step` in the surface has to ask for it.
#
# Nothing here is new capability. Every piece was already reachable:
#
#   * which attribute keys a node has      -> `NKEYS` / `KEY_AT`, already SORTED and already without `kind`
#   * which labels a node has              -> `NLABELS` / `LABEL_AT`, already sorted (`Graph.labels`)
#   * whether a value is a truth or absent -> `VKIND`
#   * walking an edge backwards            -> `NSOURCES` / `SOURCE_AT`
#
# The one native is `find_type`, and it is the `find_function` boundary again: a NAME to its node is a
# lookup over every node of a kind, which is the scan `types.instances` refuses at length. Everything the
# type is then asked — its `base` chain, its `requires_attr` edges — is ordinary structure, walked here.
#
# **No sort is written, and that is a decision rather than luck.** The two reflection families already
# answer in sorted order, because the substrate decided long ago that a program walking the same node
# twice must walk it alike. So the Python's `sorted(...)` had nothing to reproduce, and the unions it
# takes are two-pointer merges of lists that arrive ordered. Writing a sort here would have been a second
# opinion about an order the substrate already owns — and a deterministic computation ending in a set is
# the defect shape this codebase records at length.


# Walk `original` upward until leaving every workbench, and answer with the real node — or NOTHING for a
# node that exists only in imagination. `workbench.resolve`, instruction for instruction.
#
# Those two answers must not be conflated: *no real node* means *this does not exist yet and must be
# created when the plan runs*, and what ties it to reality later is the transformation that produced it,
# never a pointer.
#
# The walk ends at a node whose `original` is ITSELF, which is a positive fact rather than a missing
# pointer — an imagined node is its own identity — so a loop written for the absence would spin on it.
# The `seen` set is the second guard, and it is carried rather than dropped: without it a longer cycle in
# a malformed graph would hang here, where the Python it mirrors answers. A scratch node used as a set,
# scrapped before returning.
fn resolve_mapping(mapping) -> thing:
    NEW R(seen) "seen"
    GET R(node) F(mapping) "original"
.walk:
    JMPNOT R(node) .answer
    DEREF R(been) R(seen) R(node)
    JMPIF R(been) .answer
    SETREF R(seen) R(node) R(seen)
    INVOKE R(m) mapping_over node=R(node)
    JMPNOT R(m) .answer
    GET R(nxt) R(m) "original"
    EQ R(itself) R(nxt) R(node)
    JMPIF R(itself) .nothing
    COPY R(node) R(nxt)
    JMP .walk
.nothing:
    CONST R(node) null
.answer:
    DROP R(seen)
    COPY R(result) R(node)


# Is `mapping` a node that exists only in imagination? `workbench.is_imagined`, which is `resolve`
# answering nothing — asked THROUGH the walk rather than as *does this lack an original*, so there is one
# walk rather than two that have to agree.
fn imagined(mapping) -> thing:
    INVOKE R(real) resolve_mapping mapping=F(mapping)
    EQ R(result) R(real) null


# The mapping that has `node` as its `image`, or nothing. A node is the image of at most one mapping, so
# there is nothing to choose between — which matters, because sources answer in node-id order and an
# ordered answer here would be an accident rather than a fact.
fn mapping_over(node) -> thing:
    NSOURCES R(n) F(node) "image"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .none
    SOURCE_AT R(m) F(node) "image" R(i)
    KIND R(k) R(m)
    EQ R(is_mapping) R(k) "mapping"
    JMPIF R(is_mapping) .found
    ADD R(i) R(i) 1
    JMP .each
.found:
    COPY R(result) R(m)
    JMP .end
.none:
    CONST R(result) null
.end:
    CONST R(done) true


# The real node an imagined one stands for — `workbench.original_of`. Identity for a real node, and
# NOTHING for one minted purely in imagination. Those two must not be conflated: *no real node* means
# *this does not exist yet*, which is exactly the case a link expectation can only ask to APPEAR.
fn real_behind(node) -> thing:
    JMPNOT F(node) .nothing
    INVOKE R(m) mapping_over node=F(node)
    JMPNOT R(m) .itself
    INVOKE R(result) resolve_mapping mapping=R(m)
    JMP .end
.itself:
    COPY R(result) F(node)
    JMP .end
.nothing:
    CONST R(result) null
.end:
    CONST R(done) true


# The version this mapping succeeded, wherever it lives — `workbench._predecessor`.
#
# It used to have to sit in the previous frame, which was true only while every frame held a version of
# everything. A sparse frame's predecessor is the last frame that CHANGED this node, which may be several
# frames back, and demanding the immediate one silently reported no change at all.
fn predecessor_of(mapping) -> thing:
    NSOURCES R(n) F(mapping) "next"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .none
    SOURCE_AT R(s) F(mapping) "next" R(i)
    KIND R(k) R(s)
    EQ R(is_mapping) R(k) "mapping"
    JMPIF R(is_mapping) .found
    ADD R(i) R(i) 1
    JMP .each
.found:
    COPY R(result) R(s)
    JMP .end
.none:
    CONST R(result) null
.end:
    CONST R(done) true


# Every attribute key a type demands, its inherited ones included — the KEYS of `types.attrs_of`, and only
# the keys, because that is all `predicted_changes` asks of it.
#
# Answered as a node used as a SET: each key is a stored reference from the key to itself, so membership
# is one `DEREF` rather than a scan. The base chain is walked nearest-first and a nearer declaration
# simply re-states a key already present, which is why overriding needs no care here — two claims about
# one slot collapse to one key either way.
fn demanded_keys(type_name) -> thing:
    NEW R(out) "keys"
    JMPNOT F(type_name) .end
    NATIVE R(t) "find_type" F(type_name)
.each_type:
    JMPNOT R(t) .end
    COUNT R(nr) R(t) "requires_attr"
    CONST R(i) 0
.each_req:
    LT R(more) R(i) R(nr)
    JMPNOT R(more) .up
    GET_AT R(r) R(t) "requires_attr" R(i)
    ATTR R(key) R(r) "key"
    SETREF R(out) R(key) R(out)
    ADD R(i) R(i) 1
    JMP .each_req
.up:
    ATTR R(base) R(t) "base"
    JMPNOT R(base) .end
    NATIVE R(t) "find_type" R(base)
    JMP .each_type
.end:
    COPY R(result) R(out)


# Record one expectation on the prediction. `sort` is what a reader loops on — and is exactly the kind of
# condition a dispatching predicate would select a body on, which is why it is an attribute rather than
# three different edge labels.
fn expect_kind(out, wanted) -> thing:
    NEW R(e) "kind_expectation"
    SET R(e) "sort" "kind"
    SET R(e) "wanted" F(wanted)
    LINK F(out) "expect" R(e)
    COPY R(result) R(e)


# Has this prediction already asked for a node of this kind? WHICH kinds appeared, never how many: a mock
# that mints two file nodes is giving a witness, not a promise.
fn already_expects_kind(out, wanted) -> thing:
    COUNT R(n) F(out) "expect"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(n)
    JMPNOT R(more) .no
    GET_AT R(e) F(out) "expect" R(i)
    ATTR R(w) R(e) "wanted"
    EQ R(same) R(w) F(wanted)
    JMPIF R(same) .yes
    ADD R(i) R(i) 1
    JMP .each
.yes:
    CONST R(result) true
    JMP .end
.no:
    CONST R(result) false
.end:
    CONST R(done) true


# The attribute half of the difference between two versions of one node.
#
# The key lists arrive sorted from `NKEYS`/`KEY_AT`, so this is a two-pointer merge and never a sort. A
# key present in only one of the two still has to be visited — an attribute that appeared and one that was
# cleared are both changes — which is what makes it a merge rather than a walk of either side.
fn attr_changes(out, mapping, was, now, settled) -> thing:
    NKEYS R(nw) F(was)
    NKEYS R(nn) F(now)
    CONST R(a) 0
    CONST R(b) 0
.merge:
    LT R(more_a) R(a) R(nw)
    LT R(more_b) R(b) R(nn)
    JMPIF R(more_a) .have_a
    JMPNOT R(more_b) .done
    KEY_AT R(key) F(now) R(b)
    ADD R(b) R(b) 1
    JMP .consider
.have_a:
    JMPIF R(more_b) .both
    KEY_AT R(key) F(was) R(a)
    ADD R(a) R(a) 1
    JMP .consider
.both:
    KEY_AT R(ka) F(was) R(a)
    KEY_AT R(kb) F(now) R(b)
    EQ R(same) R(ka) R(kb)
    JMPIF R(same) .take_both
    LT R(a_first) R(ka) R(kb)
    JMPIF R(a_first) .take_a
    COPY R(key) R(kb)
    ADD R(b) R(b) 1
    JMP .consider
.take_a:
    COPY R(key) R(ka)
    ADD R(a) R(a) 1
    JMP .consider
.take_both:
    COPY R(key) R(ka)
    ADD R(a) R(a) 1
    ADD R(b) R(b) 1

.consider:
    # What the cast already owns is not this function's business, so a failure is reported once, in the
    # place that owns it.
    DEREF R(is_settled) F(settled) R(key)
    JMPIF R(is_settled) .merge
    ATTR R(before) F(was) R(key)
    ATTR R(after) F(now) R(key)
    EQ R(unchanged) R(before) R(after)
    JMPIF R(unchanged) .merge

    # A boolean or a clearing is qualitative and kept exact; any other value is an ILLUSTRATION, so only
    # the fact that it was written is expected. `mode` says which, rather than a magic value: an attribute
    # holding nothing is absent, so the node could not tell *expected to be cleared* from *nothing
    # expected* by the value alone.
    NEW R(e) "attr_expectation"
    SET R(e) "sort" "attr"
    SET R(e) "key" R(key)
    LINK R(e) "mapping" F(mapping)
    VKIND R(vk) R(after)
    EQ R(is_truth) R(vk) "truth"
    JMPIF R(is_truth) .exact
    EQ R(is_nothing) R(vk) "nothing"
    JMPIF R(is_nothing) .exact
    SET R(e) "mode" "set"
    JMP .recorded
.exact:
    SET R(e) "mode" "exact"
    SET R(e) "want" R(after)
.recorded:
    LINK F(out) "expect" R(e)
    JMP .merge
.done:
    CONST R(result) true


# The link half, and the same merge over `NLABELS`/`LABEL_AT`.
#
# Qualitative, never quantitative: `before == after` is the only test, so a listing that produced three
# files where the mock illustrated two is not a divergence. The number in a mock is a witness.
fn link_changes(out, mapping, was, now) -> thing:
    NLABELS R(nw) F(was)
    NLABELS R(nn) F(now)
    CONST R(a) 0
    CONST R(b) 0
.merge:
    LT R(more_a) R(a) R(nw)
    LT R(more_b) R(b) R(nn)
    JMPIF R(more_a) .have_a
    JMPNOT R(more_b) .done
    LABEL_AT R(label) F(now) R(b)
    ADD R(b) R(b) 1
    JMP .consider
.have_a:
    JMPIF R(more_b) .both
    LABEL_AT R(label) F(was) R(a)
    ADD R(a) R(a) 1
    JMP .consider
.both:
    LABEL_AT R(la) F(was) R(a)
    LABEL_AT R(lb) F(now) R(b)
    EQ R(same) R(la) R(lb)
    JMPIF R(same) .take_both
    LT R(a_first) R(la) R(lb)
    JMPIF R(a_first) .take_a
    COPY R(label) R(lb)
    ADD R(b) R(b) 1
    JMP .consider
.take_a:
    COPY R(label) R(la)
    ADD R(a) R(a) 1
    JMP .consider
.take_both:
    COPY R(label) R(la)
    ADD R(a) R(a) 1
    ADD R(b) R(b) 1

.consider:
    COUNT R(before) F(was) R(label)
    COUNT R(after) F(now) R(label)
    EQ R(unchanged) R(before) R(after)
    JMPIF R(unchanged) .merge

    # Name the real target when there is one. An edge names an IDENTITY, so the real node is one hop
    # away — and an imagined target answers nothing there, which is exactly the case that can only be
    # expected to appear.
    CONST R(target) null
    CONST R(j) 0
.each_target:
    LT R(more_t) R(j) R(after)
    JMPNOT R(more_t) .record
    GET_AT R(t) F(now) R(label) R(j)
    INVOKE R(real) real_behind node=R(t)
    JMPNOT R(real) .next_target
    COPY R(target) R(real)
.next_target:
    ADD R(j) R(j) 1
    JMP .each_target

.record:
    NEW R(e) "link_expectation"
    SET R(e) "sort" "link"
    SET R(e) "label" R(label)
    LINK R(e) "mapping" F(mapping)
    JMPNOT R(target) .presence
    LINK R(e) "target" R(target)
.presence:
    JMPIF R(after) .some
    SET R(e) "presence" "none"
    JMP .recorded
.some:
    SET R(e) "presence" "some"
.recorded:
    LINK F(out) "expect" R(e)
    JMP .merge
.done:
    CONST R(result) true


# What the imagined step said would happen — derived from the two frames, never recorded.
#
# Frame N-1 and frame N ARE the before and after, so the expectation is their difference: nothing to
# author, nothing to store, and nothing that can fall out of step with the plan. Recording expectation
# nodes was the obvious alternative and would have been a labelling error — asserting what the structure
# already entails — as well as costing a node per imagined state, of which the driver makes hundreds.
#
# Transient. The caller drops it, as with `reachable`'s walk node.
fn predicted_changes(prev_frame, frame) -> thing:
    NEW R(out) "prediction"
    GET R(tr) F(frame) "via"
    CONST R(expects) null
    JMPNOT R(tr) .settled
    ATTR R(expects) R(tr) "expects"
.settled:
    INVOKE R(settled) demanded_keys type_name=R(expects)

    # Nodes this step brought into existence: imagined, and with no predecessor.
    COUNT R(nm) F(frame) "mapping"
    CONST R(i) 0
.each_new:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .each_changed
    GET_AT R(m) F(frame) "mapping" R(i)
    INVOKE R(is_new) imagined mapping=R(m)
    JMPNOT R(is_new) .next_new
    # *No* predecessor, of any kind — deliberately not `predecessor_of`, which filters to mappings.
    # `workbench._newly_minted` asks whether anything at all succeeds this one, and narrowing it here
    # would be a second opinion about what counts as a predecessor.
    NSOURCES R(has_prev) R(m) "next"
    JMPIF R(has_prev) .next_new
    GET R(img) R(m) "image"
    KIND R(want) R(img)
    INVOKE R(seen) already_expects_kind out=R(out) wanted=R(want)
    JMPIF R(seen) .next_new
    INVOKE R(_e) expect_kind out=R(out) wanted=R(want)
.next_new:
    ADD R(i) R(i) 1
    JMP .each_new

    # ...and what changed about nodes that already existed.
.each_changed:
    CONST R(i) 0
.changed:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .finish
    GET_AT R(m) F(frame) "mapping" R(i)
    INVOKE R(prev_m) predecessor_of mapping=R(m)
    JMPNOT R(prev_m) .next_changed
    GET R(was) R(prev_m) "image"
    GET R(now) R(m) "image"
    INVOKE R(_a) attr_changes out=R(out) mapping=R(m) was=R(was) now=R(now) settled=R(settled)
    INVOKE R(_l) link_changes out=R(out) mapping=R(m) was=R(was) now=R(now)
.next_changed:
    ADD R(i) R(i) 1
    JMP .changed

.finish:
    DROP R(settled)
    COPY R(result) R(out)
