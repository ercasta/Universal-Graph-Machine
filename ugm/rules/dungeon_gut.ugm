# The dungeon, step 3: `dungeon_micro.ugm` unchanged, plus a JUDGE lane, a
# REFLEX lane, and now two MAIN-lane rules that close the loop -- hero
# actually acts on what the gut-feeling layer noticed.
#
# `judge` notices two things about the situation nothing else here reads:
# hero's own hp running low, and an enemy in the room who outweighs hero on
# hp. Each writes a gut-feeling node -- `fear(hero, $v)`, `wary(hero, $e)`.
# `reflex` reads those and auto-attends what they are about, once the
# magnitude clears a threshold -- `startled(hero)` only at the DESPERATE
# band (hp <= 3), `eyeing(hero, $e)` for any enemy that outweighs hero.
# Both lanes run every round, after `main`, against the SAME frame, so a
# reflex rule sees a gut feeling `judge` deposited a moment earlier in that
# same round.
#
# The two new main-lane rules read those beliefs back:
#
#   <hero-targets-threat>  wary of an enemy -> attacks THAT one instead of
#                           whatever the player declared, once it is the
#                           attended one -- overrides the plan, not the turn.
#   <hero-flees>            startled (desperate, not merely worried) ->
#                           leaves the fight outright, `over(hero_fled)`
#                           rather than `hero_falls` -- a survived retreat,
#                           not a loss dressed up as one.
#
# Both are `standing` -- STANDING(10) against `<hero-acts>`'s FLOOR(1), a
# ten-point gap that clears TOLERANCE(2), so when one of them matches the
# shortlist walk never even tries the ordinary action that round; no doubt,
# no tie. They cannot both match at once either: `<hero-targets-threat>`
# is guarded `no startled(hero)`, so the worse fear always wins the turn
# over the milder one. This is a REACTION, not a strategy: seeds 1 and 6
# (see `dungeon_gut.py`) dip to 1 and 3 hp and go on to WIN in the plain
# microprogram port -- fleeing there trades a winnable fight for safety,
# which is what an emotional reaction is allowed to cost. Retargeting can
# cost something too, not only by omission: seed 30 of `dungeon_gut.py`'s
# own 30-seed scan WINS in the plain port and FALLS here, because
# `<hero-targets-threat>` sent hero after the enemy that read as more
# dangerous rather than the one the fight actually turned on. Noticed, not
# designed around -- a corpus that wanted the reaction without the risk
# would have to say so with a rule of its own.
#
# `danger`, `scary` and `stronger` are computators, registered by the probe
# exactly as `calc`/`beats` are (see `dungeon_micro.ugm`'s own header for
# why a computator and not a tool).

fact +monster(goblin1)
fact +monster(goblin2)

fact +present(hero)
fact +present(goblin1)
fact +present(goblin2)

fact +hp(hero, 12)
fact +hp(goblin1, 5)
fact +hp(goblin2, 5)

fact +ac(hero, 13)
fact +ac(goblin1, 11)
fact +ac(goblin2, 11)

fact +die(hero, d6)
fact +die(goblin1, d4)
fact +die(goblin2, d4)

fact +follows(goblin1, hero)
fact +follows(goblin2, goblin1)
fact +follows(hero, goblin2)

fact +turn(hero)
fact +may(hero)

# -- the player --------------------------------------------------------------

rule <trust-player>
  +says(player, declares($act, $r))
  no intends(hero, $act, $r)
->
  +intends(hero, $act, $r)

rule <hero-acts>
  +turn(hero)
  +may(hero)
  +present(hero)
alt
  $intent = intends(hero, attack($t), $r)
  +present($t)
alt
  $intent = intends(hero, attack($d), $r)
  no present($d)
  +monster($t)
  +present($t)
->
  -may(hero)
  -$intent
  +attack(hero, $t)

rule <hero-holds>
  +turn(hero)
  +may(hero)
  +present(hero)
  +monster($e)
  +present($e)
->
  -may(hero)
  +attack(hero, $e)

# -- the monsters ------------------------------------------------------------

rule <gob-acts>
  +turn($x)
  +may($x)
  +monster($x)
  +present($x)
  +present(hero)
  no hp($x, 1)
->
  -may($x)
  +attack($x, hero)

rule <gob-flees>
  +turn($x)
  +may($x)
  +monster($x)
  +present($x)
  +hp($x, 1)
->
  -may($x)
  -present($x)
  +fled($x)
  +done($x)

# -- the mechanics -----------------------------------------------------------

rule <swing>
  $atk = attack($a, $d)
  no roll(d20, hit($a, $d))
->
  +roll(d20, hit($a, $d))

rule <hit>
  $atk = attack($a, $d)
  $hit = answered(<dice>, roll(d20, hit($a, $d)), $n)
  +ac($d, $c)
  beats($n, $c)
  no hits($a, $d)
->
  +hits($a, $d)

rule <miss>
  $atk = attack($a, $d)
  $hit = answered(<dice>, roll(d20, hit($a, $d)), $n)
  +ac($d, $c)
  no beats($n, $c)
->
  -$atk
  +missed($a, $d)
  +done($a)
=> forget $hit

rule <harm>
  +hits($a, $d)
  +die($a, $dd)
  no roll($dd, hurt($a, $d))
->
  +roll($dd, hurt($a, $d))

rule <wound>
  $atk = attack($a, $d)
  $h_it = hits($a, $d)
  $hit = answered(<dice>, roll(d20, hit($a, $d)), $hitroll)
  $dmg = answered(<dice>, roll($dd, hurt($a, $d)), $n)
  $hp = hp($d, $h)
  $new = calc(sub, $h, $n)
->
  -$atk
  -$h_it
  -$hp
  +hp($d, $new)
  +done($a)
=> forget $hit, forget $dmg

rule <falls>
  +hp($x, 0)
  +present($x)
->
  -present($x)
  +dead($x)

# -- the gut feelings (judge lane) --------------------------------------

# Near-death: hero's own hp read every round, banded into a fear score.
# Guarded on the SCORE rather than on hp, so a further drop that lands on
# the same band does not re-write it -- but a value once written is not
# taken back if hp climbs, which cannot happen in this fight (there is no
# healing rule) and is exactly the corner a real emotional model would have
# to close.
rule <sense-danger>
  +hp(hero, $h)
  danger($h) as $v
  no fear(hero, $v)
->
  +fear(hero, $v)
fact +lane(<sense-danger>, judge)

# A stronger enemy in sight: any present monster whose hp outweighs hero's
# own, right now.
rule <sense-threat>
  +hp(hero, $hh)
  +monster($e)
  +present($e)
  +hp($e, $eh)
  stronger($eh, $hh)
  no wary(hero, $e)
->
  +wary(hero, $e)
fact +lane(<sense-threat>, judge)

# -- the reflexes (reflex lane) ------------------------------------------

# Loud enough to notice: attends hero, so whatever the loop reaches for
# next is lifted by having hero at the front of the queue.
rule <startle>
  +fear(hero, $v)
  scary($v)
  no startled(hero)
->
  +startled(hero)
=> attend(hero, 5)
fact +lane(<startle>, reflex)

# The threat itself gets attended, not just hero -- the reflex-layer
# analogue of a glance.
rule <eye-the-threat>
  +wary(hero, $e)
  no eyeing(hero, $e)
->
  +eyeing(hero, $e)
=> attend($e, 5)
fact +lane(<eye-the-threat>, reflex)

fact +lane_order(judge, 1)
fact +lane_order(reflex, 2)

# -- closing the loop (main lane, standing) ------------------------------

# The milder reaction: retarget onto whatever the reflex lane is eyeing,
# in place of the player's own declared target -- but only while hero is
# not ALSO desperate, so a worse fear always wins the turn.
rule <hero-targets-threat>
  +turn(hero)
  +may(hero)
  +present(hero)
  +wary(hero, $e)
  +present($e)
  attentioned($e)
  no startled(hero)
->
  -may(hero)
  +attack(hero, $e)
fact +standing(<hero-targets-threat>)

# The severe reaction: hero leaves the fight rather than press on. Mirrors
# `<gob-flees>`'s own shape -- `-present`, `+fled`, `+done` -- but the
# outcome it claims is its own, so a retreat is never read back as a death.
rule <hero-flees>
  +turn(hero)
  +may(hero)
  +present(hero)
  +startled(hero)
  no fled(hero)
->
  -may(hero)
  -present(hero)
  +fled(hero)
  +done(hero)
  +over(hero_fled)
fact +standing(<hero-flees>)

# -- the clock ---------------------------------------------------------------

rule <skip>
  +turn($x)
  +may($x)
  no present($x)
->
  -may($x)
  +done($x)

rule <pass>
  +done($x)
  +turn($x)
  +follows($y, $x)
->
  -turn($x)
  -done($x)
  +turn($y)
  +may($y)

# -- the end -----------------------------------------------------------------

rule <victory>
  no present(goblin1)
  no present(goblin2)
  no over(hero_wins)
->
  +over(hero_wins)

rule <defeat>
  no present(hero)
  no fled(hero)
  no over(hero_falls)
->
  +over(hero_falls)

rule <halt>
  +turn($x)
  +may($x)
  +over($w)
->
  -may($x)

# -- what the player declared ------------------------------------------------

say player: +declares(attack(goblin1), 1)
say player: +declares(attack(goblin1), 2)
say player: +declares(attack(goblin1), 3)
