# Teaching the system a new way of saying something — in the surface, through the closed vocabulary.
#
# `construction.py`'s Python helpers author a construction; these do the same job with nothing but
# `make`, `set_slot` and `relate`. That is what turns "growth is data" from a claim about the
# *representation* into a claim about the *surface*: a rule can teach the system a construction, so the
# thing that grows the language is the same thing the language produces.
#
# It is also the bootstrap the learning story needs. Harmonization proposes learning the rule ordering
# and `docs/comparison.md` proposes learning constructions; you cannot learn what you cannot author, and
# until now authoring one meant calling Python.

# A construction: a form-meaning pair, addressing one token by its lemma.
#
# The address goes into `wants_sort` / `wants_label` — the same two attributes a criterion uses, which is
# what lets `precedence._covers` order two constructions by specificity without anything being arranged
# here.
fn new_construction(label, sort, lemma) -> thing:
    INVOKE R(c) make kind="construction"
    INVOKE R(_) set_slot node=R(c) key="label" value=F(label)
    INVOKE R(_) set_slot node=R(c) key="strength" value="should"
    INVOKE R(_) set_slot node=R(c) key="wants_sort" value=F(sort)
    INVOKE R(_) set_slot node=R(c) key="wants_label" value=F(lemma)
    COPY R(result) R(c)

# `some <name> in <ref> by <link>` — reach another role by walking. This is how word order enters as
# form rather than as grammar: the walk offers candidates, and the tests below say which one is meant.
fn add_draw(c, name, ref, label) -> thing:
    INVOKE R(d) make kind="draw"
    INVOKE R(_) set_slot node=R(d) key="name" value=F(name)
    INVOKE R(_) set_slot node=R(d) key="ref" value=F(ref)
    INVOKE R(_) set_slot node=R(d) key="label" value=F(label)
    INVOKE R(_) set_slot node=R(d) key="back" value=false
    INVOKE R(_) relate node=F(c) label="draw" other=R(d)
    COPY R(result) R(d)

# The same, walking the relation backwards — `by ^next` is "the tokens before this one".
fn add_draw_back(c, name, ref, label) -> thing:
    INVOKE R(d) make kind="draw"
    INVOKE R(_) set_slot node=R(d) key="name" value=F(name)
    INVOKE R(_) set_slot node=R(d) key="ref" value=F(ref)
    INVOKE R(_) set_slot node=R(d) key="label" value=F(label)
    INVOKE R(_) set_slot node=R(d) key="back" value=true
    INVOKE R(_) relate node=F(c) label="draw" other=R(d)
    COPY R(result) R(d)

# `when <ref> exists` — the condition that does the grounding work here, since a token that denotes
# nothing is a token this reading is not about.
fn add_test_exists(c, left) -> thing:
    INVOKE R(t) make kind="test"
    INVOKE R(_) set_slot node=R(t) key="sort" value="exists"
    INVOKE R(_) set_slot node=R(t) key="left" value=F(left)
    INVOKE R(_) set_slot node=R(t) key="negated" value=false
    INVOKE R(_) relate node=F(c) label="test" other=R(t)
    COPY R(result) R(t)

# `when <left> <label> <right>` — a relation that must hold in the world for this reading to stand.
# This is the line that lets the world decide an attachment.
fn add_test_link(c, left, label, right) -> thing:
    INVOKE R(t) make kind="test"
    INVOKE R(_) set_slot node=R(t) key="sort" value="link"
    INVOKE R(_) set_slot node=R(t) key="left" value=F(left)
    INVOKE R(_) set_slot node=R(t) key="label" value=F(label)
    INVOKE R(_) set_slot node=R(t) key="right" value=F(right)
    INVOKE R(_) set_slot node=R(t) key="negated" value=false
    INVOKE R(_) relate node=F(c) label="test" other=R(t)
    COPY R(result) R(t)

# The same condition, denied — `unless <left> <label> <right>`.
fn add_test_not_link(c, left, label, right) -> thing:
    INVOKE R(t) make kind="test"
    INVOKE R(_) set_slot node=R(t) key="sort" value="link"
    INVOKE R(_) set_slot node=R(t) key="left" value=F(left)
    INVOKE R(_) set_slot node=R(t) key="label" value=F(label)
    INVOKE R(_) set_slot node=R(t) key="right" value=F(right)
    INVOKE R(_) set_slot node=R(t) key="negated" value=true
    INVOKE R(_) relate node=F(c) label="test" other=R(t)
    COPY R(result) R(t)

# What the reading MEANS: a call that authors the goal. The function it names is an ordinary
# microfunction, so what an utterance can mean is bounded by what the library can do rather than by
# anything in the interpreter.
fn add_builds(c, function) -> thing:
    INVOKE R(q) make kind="consequent"
    INVOKE R(_) set_slot node=R(q) key="does" value="call"
    INVOKE R(_) set_slot node=R(q) key="function" value=F(function)
    INVOKE R(_) relate node=F(c) label="consequent" other=R(q)
    COPY R(result) R(q)

# One argument of that call, as a reference resolved when the reading is made rather than now — which is
# the whole reason a construction is reusable across situations.
fn add_binding(q, param, ref) -> thing:
    INVOKE R(b) make kind="binds"
    INVOKE R(_) set_slot node=R(b) key="param" value=F(param)
    INVOKE R(_) set_slot node=R(b) key="ref" value=F(ref)
    INVOKE R(_) relate node=F(q) label="arg" other=R(b)
    COPY R(result) R(b)
