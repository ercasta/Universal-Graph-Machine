# Minting a version — what a WRITE means while imagining.
#
# The reading half (`resolve.mf`) answers *which version of this node is in force here*. This is the
# other half: a write must land on a version **belonging to this frame**, so that changing something in
# frame N does not change what frame N−1 said. That is the whole of copy-on-write, and it is what lets a
# frame stop carrying a copy of the world and carry only what changed in it.
#
# The context names this the way it names its resolver — by name, at run time — so the vocabulary's three
# writing members call it without knowing what a frame is, exactly as the reading members call the
# resolver. A context with no writer falls back to its resolver, which is what the real world wants:
# there is one version of everything and writes land on it.
#
# **Edges are not separately versioned.** A new version carries the node's whole edge set, and its edges
# point wherever the old ones did — at an earlier version, typically. That is not stale, because reading
# an edge's target resolves it: `in_frame` maps an image back to what it is a version *of* before it
# walks. Resolution on the target is what makes edge copying sound, and it is why a hub node that never
# changes costs nothing however often its members do.

# Copy a node with its attributes, its edges and its edge properties.
#
# `copy_node` does the attributes and the kind; the edges are this function's own business, and they are
# copied to the SAME targets rather than being rewritten — which is the difference from `copy_set`, whose
# whole job is rewriting edges into a parallel world. Here there is no parallel world to rewrite into.
#
# The new edge is addressed as the LAST one at that label, which holds because `LINK` appends and this is
# the only thing linking the image while the loop runs — `copy_set`'s idiom, and the same reasoning.
fn copy_with_edges(node) -> thing:
    INVOKE R(image) copy_node original=F(node)
    NLABELS R(nl) F(node)
    CONST R(li) 0
.each_label:
    LT R(more_l) R(li) R(nl)
    JMPNOT R(more_l) .done
    LABEL_AT R(lbl) F(node) R(li)
    COUNT R(nt) F(node) R(lbl)
    CONST R(ti) 0
.each_target:
    LT R(more_t) R(ti) R(nt)
    JMPNOT R(more_t) .next_label
    GET_AT R(t) F(node) R(lbl) R(ti)
    LINK R(image) R(lbl) R(t)
    COUNT R(made) R(image) R(lbl)
    ADD R(at) R(made) -1
    NEPROPS R(np) F(node) R(lbl) R(ti)
    CONST R(pi) 0
.each_prop:
    LT R(more_p) R(pi) R(np)
    JMPNOT R(more_p) .next_target
    EPROP_AT R(pk) F(node) R(lbl) R(ti) R(pi)
    EPROP R(pv) F(node) R(lbl) R(ti) R(pk)
    SETEPROP R(image) R(lbl) R(at) R(pk) R(pv)
    ADD R(pi) R(pi) 1
    JMP .each_prop
.next_target:
    ADD R(ti) R(ti) 1
    JMP .each_target
.next_label:
    ADD R(li) R(li) 1
    JMP .each_label
.done:
    COPY R(result) R(image)


# The version of `node` this frame may write to, minting one if the frame has none.
#
# Three cases, and the middle one is the whole point:
#
#   * the version in force already belongs to this frame  -> write to it
#   * it belongs to an ancestor                           -> copy it, and record the copy HERE
#   * there is no version at all (a node outside the
#     workbench, or the real world)                       -> write to the node itself
#
# The new mapping keeps the same `original` as the one it succeeds, because every version of a thing in a
# workbench names the same identity — that is what makes `in_frame` able to find any of them from the
# canonical node, and what makes an edge pointing at an identity mean something stable. It also links
# `previous -next-> new`, which is what orders one node's versions, as `frame -next-> frame` orders the
# world's.
fn version_in_frame(node) -> thing:
    NATIVE R(ctx) "context"
    GET R(want) R(ctx) "frame"
    INVOKE R(here) in_frame node=F(node)

    # Which mapping the version in force belongs to. A version is the `image` of exactly one mapping;
    # a node that is nobody's image has no version to succeed, and is written to directly.
    NSOURCES R(nm) R(here) "image"
    CONST R(i) 0
.each:
    LT R(more) R(i) R(nm)
    JMPNOT R(more) .as_is
    SOURCE_AT R(m) R(here) "image" R(i)
    KIND R(k) R(m)
    EQ R(is_mapping) R(k) "mapping"
    JMPIF R(is_mapping) .found
    ADD R(i) R(i) 1
    JMP .each

    # Does this frame already hold it? One `DEREF` against the frame's own index, rather than asking
    # the mapping which frame it belongs to — the same lookup `in_frame` makes, from the other end.
.found:
    GET R(orig) R(m) "original"
    COPY R(ident) R(orig)
    JMPIF R(orig) .have_identity
    COPY R(ident) R(here)
.have_identity:
    DEREF R(mine) R(want) R(ident)
    EQ R(ours) R(mine) R(m)
    JMPIF R(ours) .as_is

    # It belongs to an ancestor: this frame gets its own version of it, and nothing earlier moves.
    INVOKE R(fresh) copy_with_edges node=R(here)
    NEW R(nmap) "mapping"
    JMPNOT R(orig) .imagined
    LINK R(nmap) "original" R(orig)
.imagined:
    LINK R(nmap) "image" R(fresh)
    LINK R(m) "next" R(nmap)
    LINK R(want) "mapping" R(nmap)
    SETREF R(want) R(ident) R(nmap)
    COPY R(result) R(fresh)
    RET

.as_is:
    COPY R(result) R(here)
