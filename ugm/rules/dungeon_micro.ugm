# A fight, run by rules -- step 2 of the recovery: the SAME corpus as
# `dungeon.ugm` (the control), rewritten to use the microprogram pieces
# `new_substrate.md` built this session. Behaviour is meant to be identical;
# what changed is only how much of it a rule has to spell out.
#
# Four constructs used here that the control does not have:
#
#     $z = p(...)          instance-node binding, prefix spelling of `as`
#     -$z                  bare-variable erasure -- erase what `$z` matched
#     alt(...)             a union of conjunctive branches, one Rule each,
#                           compiled at load -- not a runtime branch
#     forget $hit           erase a tool's answer and the request it named,
#                           together, structurally
#
# ...and one decision this port makes that the control did not have to:
# `calc` and `beats` are COMPUTATORS here, not tools. `<arith>` and
# `<compare>` disappear entirely, and with them `<check-ac>` and
# `<subtract>` -- four rules and two tools gone, on the doc's own argument:
# a computator is a PURE function, and neither of these touches the world.
# Only `<dice>` remains a tool, because a die genuinely is the world
# speaking. `no beats($n, $c)` -- a `no` in front of a computator member --
# needed a real engine fix first (found while planning this port: the
# computator branch ran before the ABSENT check could ever see it, so `no`
# was silently ignored). That fix is in `rules.match` now, not here.
#
# See `dungeon.ugm` for the world, the recovery notes, and the six
# starvation guards this port carries over unchanged (`_inert` is gone
# there too, and it is the same engine).

# -- the world ---------------------------------------------------------------

fact +monster(goblin1)
fact +monster(goblin2)

fact +present(hero)
fact +present(goblin1)
fact +present(goblin2)

fact +hp(hero, 12)
fact +hp(goblin1, 5)
fact +hp(goblin2, 5)

fact +ac(hero, 13)
fact +ac(goblin1, 11)
fact +ac(goblin2, 11)

fact +die(hero, d6)
fact +die(goblin1, d4)
fact +die(goblin2, d4)

fact +follows(goblin1, hero)
fact +follows(goblin2, goblin1)
fact +follows(hero, goblin2)

fact +turn(hero)
fact +may(hero)

# -- the player --------------------------------------------------------------

rule <trust-player> = implies(
    { +says(player, declares($act, $r)), no intends(hero, $act, $r) },
    { +intends(hero, $act, $r) } )

# The twins case this whole item was built for. `<hero-acts>` and
# `<hero-switch>` were two rules sharing every premise but one; `alt` makes
# them one rule with two ways in, both binding what the consequent uses.
rule <hero-acts> = implies(
    { +turn(hero), +may(hero), +present(hero) },
    alt(
      { $intent = intends(hero, attack($t), $r), +present($t) },
      { $intent = intends(hero, attack($d), $r), no present($d),
        +monster($t), +present($t) }
    ),
    { -may(hero), -$intent, +attack(hero, $t) } )

rule <hero-holds> = implies(
    { +turn(hero), +may(hero), +present(hero),
      +monster($e), +present($e) },
    { -may(hero), +attack(hero, $e) } )

# -- the monsters ------------------------------------------------------------

rule <gob-acts> = implies(
    { +turn($x), +may($x), +monster($x), +present($x), +present(hero),
      no hp($x, 1) },
    { -may($x), +attack($x, hero) } )

rule <gob-flees> = implies(
    { +turn($x), +may($x), +monster($x), +present($x), +hp($x, 1) },
    { -may($x), -present($x), +fled($x), +done($x) } )

# -- the mechanics -----------------------------------------------------------

rule <swing> = implies(
    { $atk = attack($a, $d), no roll(d20, hit($a, $d)) },
    { +roll(d20, hit($a, $d)) } )

# `beats` is a computator, not a tool: no `binds`, so the member is a pure
# FILTER -- it matches exactly when the computed value is not None, which
# is what `<check-ac>` used to need a whole extra rule and tool round-trip
# to say.
rule <hit> = implies(
    { $atk = attack($a, $d),
      $hit = answered(<dice>, roll(d20, hit($a, $d)), $n),
      +ac($d, $c),
      beats($n, $c),
      no hits($a, $d) },
    { +hits($a, $d) } )

# ...and the same computator, asked in the negative -- the fix this port
# needed to be honest, not a workaround for it.
rule <miss> = implies(
    { $atk = attack($a, $d),
      $hit = answered(<dice>, roll(d20, hit($a, $d)), $n),
      +ac($d, $c),
      no beats($n, $c) },
    { -$atk, +missed($a, $d), +done($a) }
    ) => forget $hit

rule <harm> = implies(
    { +hits($a, $d), +die($a, $dd), no roll($dd, hurt($a, $d)) },
    { +roll($dd, hurt($a, $d)) } )

# `<subtract>` is gone. `calc` is a computator, so `<wound>` computes `$new`
# inline instead of reading a THIRD tool's answer -- one rule fewer, one
# fewer round-trip to spend.
rule <wound> = implies(
    { $atk = attack($a, $d),
      $h_it = hits($a, $d),
      $hit = answered(<dice>, roll(d20, hit($a, $d)), $hitroll),
      $dmg = answered(<dice>, roll($dd, hurt($a, $d)), $n),
      $hp = hp($d, $h),
      $new = calc(sub, $h, $n) },
    { -$atk, -$h_it, -$hp, +hp($d, $new), +done($a) }
    ) => forget $hit, forget $dmg

rule <falls> = implies(
    { +hp($x, 0), +present($x) },
    { -present($x), +dead($x) } )

# -- the clock ---------------------------------------------------------------

rule <skip> = implies(
    { +turn($x), +may($x), no present($x) },
    { -may($x), +done($x) } )

rule <pass> = implies(
    { +done($x), +turn($x), +follows($y, $x) },
    { -turn($x), -done($x), +turn($y), +may($y) } )

# -- the end -----------------------------------------------------------------

rule <victory> = implies(
    { no present(goblin1), no present(goblin2), no over(hero_wins) },
    { +over(hero_wins) } )

rule <defeat> = implies(
    { no present(hero), no over(hero_falls) },
    { +over(hero_falls) } )

rule <halt> = implies(
    { +turn($x), +may($x), +over($w) },
    { -may($x) } )

# -- what the player declared ------------------------------------------------

say player: +declares(attack(goblin1), 1)
say player: +declares(attack(goblin1), 2)
say player: +declares(attack(goblin1), 3)
